# ─── Base de données ───
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here
DATABASE_NAME=municipall

# ─── Pipeline IA ───
MUNICIPAL_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
MUNICIPAL_DUPLICATE_THRESHOLD=0.85
MUNICIPAL_ROUTE_MIN_COSINE=0.22

# ─── LiteLLM (proxy universel) ───
# Définir LITELLM_API_KEY (injecté via OpenCode ou CI/CD)
LITELLM_API_KEY=
LITELLM_MODEL=mistral/mistral-medium-2508
LITELLM_API_BASE=
LITELLM_TIMEOUT_S=120

# ─── Docker (optionnel) ───
IA_PORT=8000

# ─── Redis (optionnel) ───
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── API Key (optionnel, pour les endpoints /reporting/*) ───
# Si défini, toutes les requêtes vers /reporting/* nécessitent le header X-API-Key
API_KEY=
