# ─── Base de données ───
# Deux formats acceptés : URL directe (DATABASE_URL) ou vars séparées ci-dessous
# DATABASE_URL=postgresql://user:password@localhost:5432/municipall
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here
DATABASE_NAME=municipall

# ─── Pipeline IA ───
MUNICIPAL_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
MUNICIPAL_DUPLICATE_THRESHOLD=0.85
MUNICIPAL_ROUTE_MIN_COSINE=0.22

# ─── LiteLLM (proxy universel) ───
# Le modèle DOIT être préfixé openai/ quand on passe par un proxy LiteLLM
# (routage OpenAI-compatible). LITELLM_API_BASE = URL du proxy.
LITELLM_API_KEY=
LITELLM_MODEL=openai/glm-53-flash
LITELLM_API_BASE=https://votre-proxy-litellm.example.com/v1
LITELLM_TIMEOUT_S=120

# ─── Docker (optionnel) ───
IA_PORT=8000

# ─── Redis (optionnel) ───
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── API Key (optionnel, pour les endpoints /reporting/*) ───
# Si défini, toutes les requêtes vers /reporting/* nécessitent le header X-API-Key
API_KEY=

# ─── Backend NestJS (chatbot citoyen : perturbations transports) ───
# URL de base du backend NestJS. Si le préfixe global /api/v1 est actif
# côté backend, l'inclure dans l'URL (ex : http://localhost:3000/api/v1).
# En cas d'indisponibilité, le chatbot renvoie une liste vide + note.
BACKEND_URL=http://localhost:3002
BACKEND_TIMEOUT_S=5

# ─── Divers (optionnel) ───
# CORS_ORIGINS=http://localhost:3000,http://localhost:3002
# NODE_ENV=development
