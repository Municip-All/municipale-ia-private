# ─── Base de données ───
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here
DATABASE_NAME=municipall

# ─── Pipeline IA ───
MUNICIPAL_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
MUNICIPAL_DUPLICATE_THRESHOLD=0.85
MUNICIPAL_ROUTE_MIN_COSINE=0.22

# ─── Mistral API (NumSpot) ───
# Copier ces valeurs depuis GitHub Actions Secrets ou les définir localement
MISTRAL_API_KEY=
MISTRAL_API_BASE=https://api.mistral.numspot.com/v1
MISTRAL_MODEL=mistral-medium-2508
MISTRAL_TIMEOUT_S=120

# ─── Docker (optionnel) ───
IA_PORT=8000
